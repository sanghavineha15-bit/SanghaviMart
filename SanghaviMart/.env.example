# PostgreSQL — ONLY supported database
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=sanghavimart_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_TEST_DB=sanghavimart_test_db
DATABASE_URL=postgresql://postgres:changeme@127.0.0.1:5432/sanghavimart_db

# Drogon
DROGON_LISTEN_ADDR=0.0.0.0
DROGON_PORT=8080
DROGON_THREADS=4
JWT_SECRET=change-me-in-production-min-32-chars
SESSION_TIMEOUT=86400

# AI Chatbot
AI_CHATBOT_PROVIDER=mock
# ai.chatbot.provider=gemini to enable live Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_MS=8000
CHAT_RATE_LIMIT_PER_MIN=10
CHAT_MAX_MESSAGE_LEN=1000

# Logging
LOG_LEVEL=info
LOG_PATH=./logs
