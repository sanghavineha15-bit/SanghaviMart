# SanghaviMart on Vercel, fast lane: Python API (same /api/v1 contract as the
# C++ backend) + static storefront in ONE container. ~2min builds.
# For the native C++ image instead, point vercel.json at Dockerfile.vercel.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN pip install --no-cache-dir "psycopg[binary]" argon2-cffi
COPY demo-server.py dblib.py boot.py /app/
COPY public/ /app/public/
COPY db/ /app/db/
COPY test/catalog_v2.json test/seed_catalog_v2.py /app/test/
WORKDIR /app
# Vercel routes to port 80 by default, or $PORT when set. demo-server honors $PORT.
EXPOSE 80
CMD ["sh", "-c", "python boot.py && python demo-server.py"]
