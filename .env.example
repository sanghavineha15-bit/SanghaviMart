# Copy to .env (never commit the real one). Documented config surface.
PORT=8080
DB_RDBMS=sqlite3
DB_CONN=sanghavimart.db
# For production Postgres:
# DB_RDBMS=postgresql
# DB_CONN=host=127.0.0.1 port=5432 dbname=sanghavimart user=sanghavi password=CHANGEME
GEMINI_API_KEY=
CHAT_PROVIDER=mock
# Stateless auth for serverless/scale-to-zero fleets (Vercel). REQUIRED in
# production: the binary refuses to start when shorter than 16 chars.
# Config-file jwt_secret is the local-dev fallback; this env var always wins.
JWT_SECRET=dev-only-16plus-chars-change-me
# Vercel Postgres: set exactly one (DATABASE_URL wins). Local/compose keeps config file.
# DATABASE_URL=postgres://sanghavi:CHANGEME@host:5432/sanghavimart
# POSTGRES_URL=postgres://sanghavi:CHANGEME@host:5432/sanghavimart
# Email-code login delivery: 1 = include the code in the API response + server
# log (localhost demo). Production must set 0 and configure an email provider.
DEMO_OTP_ECHO=1
